# Copy to .env and fill in. .env is git-ignored; never commit it or any key file.
# Nothing here is needed for local mode: `pnpm dev` + `pnpm smoke` run with no .env at all.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# local: files under .data/ stand in for Cloud Storage, Pub/Sub, BigQuery, Firestore. No GCP needed.
# gcp:   real GCP services in GCP_PROJECT_ID.
CP_MODE=local

# ---------------------------------------------------------------------------
# GCP: required for CP_MODE=gcp, `pnpm infra:up`, `pnpm deploy:*`, `pnpm logs:tail`
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
# One region for the bucket, dataset, Firestore, and Cloud Run (data residency is this one setting).
GCP_REGION=asia-south1

# Credentials, pick one:
#   a) run `gcloud auth application-default login` (recommended for developers), or
#   b) point at a service-account key file kept OUTSIDE the repo:
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\keys\cp-dev-sa.json

# ---------------------------------------------------------------------------
# Site keys: which SDK keys the collector accepts, and the tenant each maps to.
# `pnpm infra:up` copies this into Secret Manager (secret: site-keys) for Cloud Run.
# Optional per-key origin allowlist: {"pk_live_x": {"tenant_id": "demo", "origins": ["https://shop.example"]}}
# ---------------------------------------------------------------------------
SITE_KEYS={"pk_local_demo":"demo"}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# pretty | json | gcp. Default: gcp on Cloud Run, pretty everywhere else.
# LOG_FORMAT=pretty
# true: a local run also ships its logs to Cloud Logging (log name cp-local), so they show in the
# GCP console next to the deployed services. Needs GCP_PROJECT_ID and credentials.
LOG_TO_CLOUD=false

# ---------------------------------------------------------------------------
# Running locally against real GCP (CP_MODE=gcp)
# ---------------------------------------------------------------------------
# The processor pulls from events.raw.processor instead of waiting for push. Use this before the
# processor is deployed; `pnpm deploy:processor` switches the subscription to push.
# PROCESSOR_PULL=true
# Same for the clusterer on signals.clusterer; `pnpm deploy:clusterer` switches it to push.
# CLUSTERER_PULL=true

# ---------------------------------------------------------------------------
# Agent service (Phase 3): Gemini via ADK. `pnpm infra:up` stores the key in Secret Manager.
# Model ids come from config, never code (AGENTS.md rule 7). Without a key the agents run an offline
# stand-in (templated text, no visual check) so the local demo still works end to end.
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY=
# AGENT_LLM=auto                    # auto | gemini | vertex | offline
#   gemini: AI Studio key (GOOGLE_API_KEY). vertex: GOOGLE_API_KEY if it is a Vertex key (starts with AQ.), else a service account (GCP_PROJECT_ID, ADC)
#   A key refused with API_KEY_SERVICE_BLOCKED on generativelanguage.googleapis.com is a Vertex key: use AGENT_LLM=vertex.
# GEMINI_MODEL_BULK=gemini-3.5-flash-lite      # triage and ranker
# GEMINI_MODEL_REASONING=gemini-3.8-flash      # root cause and the visual check
# AGENT_TENANTS=demo
# AGENT_POLL_MS=5000                # 0: no timer; POST /run triggers a pass
# AGENT_RESCORE_MS=15000            # re-score an issue at most this often
# AGENT_MAX_PER_PASS=5
# ABANDON_AFTER_IDLE_MS=120000      # cart without an order counts as abandoned after this idle time (demo value)
# BASELINE_MIN_SESSIONS=20          # fewer on the issue's route widens the baseline to all routes
# RAR_MIN_AFFECTED=3                # finished affected sessions needed before estimating revenue at risk
# REGRESSION_WINDOW_HOURS=24
# VISUAL_CHECK=true                 # render the flagged moment from the masked replay for Gemini to check
# SCREENSHOT_BROWSER=chrome         # chrome | msedge | bundled | /path/to/chromium
# PRIORITY_RULES=                   # JSON array replacing the built-in priority rule set
# AGENT_DEPLOY_VISUAL_CHECK=false   # pnpm deploy:agent: the slim image has no browser

# ---------------------------------------------------------------------------
# Tuning (defaults shown; rarely needed)
# ---------------------------------------------------------------------------
# PORT=8080                         # collector; locally the processor uses 8081, api 8082, clusterer 8083, agent 8084 (AGENT_PORT)
# MAX_CLUSTERS_PER_TENANT=500       # new issues past this are refused (a cardinality guard)
# CLUSTERED_MARKER_TTL_DAYS=8       # how long "signal already clustered" markers are kept
# INVARIANT_RULES=                  # JSON {tenant: [rule, ...]}; default is the built-in cart rule
# RAW_RETENTION_DAYS=30             # lifecycle rule on raw chunks
# MAX_BODY_BYTES=1000000            # largest compressed ingest body
# MAX_DECOMPRESSED_BYTES=10000000   # zip-bomb guard
# DETECTOR_PARAMS={"demo":{"dead_click":{"windowMs":1000}}}
# TAIL_LOOKBACK_MS=10000
# GAP_WAIT_ATTEMPTS=4
# CLOUD_RUN_MIN_INSTANCES=0         # set 1 on demo day to avoid cold starts
# BQ_DATASET=churn_preventer
# RAW_BUCKET=<project>-cp-raw
